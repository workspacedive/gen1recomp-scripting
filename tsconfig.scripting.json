{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "baseUrl": ".",
    "paths": {
      "scripting": ["types/scripting-contract.d.ts"]
    }
  },
  "include": [
    "types/scripting-contract.d.ts",
    "scripting/Gen1Recomp/**/*.ts",
    "scripting/Gen1Recomp/**/*.tsx"
  ]
}
